# Copy to .env and fill in. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DB_USER=oculus_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oculus_db
