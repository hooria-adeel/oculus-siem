    {
      "name": "Console",
      "description": "What security analysts use. Admin only.",
      "item": [
        {
          "name": "Dashboard aggregates",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Everything the Overview page needs in one call: KPIs with the prior-period value, a severity timeline, MITRE techniques, top accounts, top attacking sources and the highest insider risk.\n\n**Admin only.**",
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ],
              "query": [
                {
                  "key": "hours",
                  "value": "24",
                  "disabled": true,
                  "description": "Window. Anything other than 1, 6, 24 or 168 falls back to 24."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
