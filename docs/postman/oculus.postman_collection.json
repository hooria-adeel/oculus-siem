              "query": [
                {
                  "key": "type",
                  "value": "login_success,login_failed",
                  "disabled": true,
                  "description": "Event types. Comma-separated."
                },
                {
                  "key": "outcome",
                  "value": "success,failure",
                  "disabled": true,
                  "description": "Outcomes. Comma-separated."
                },
                {
                  "key": "severity",
                  "value": "info,low",
                  "disabled": true,
                  "description": "Severities. Comma-separated."
                },
                {
                  "key": "user",
                  "value": "",
                  "disabled": true,
                  "description": "Exact username."
                },
                {
                  "key": "ip",
                  "value": "",
                  "disabled": true,
                  "description": "Exact IP address (400 if invalid)."
                },
                {
                  "key": "hours",
                  "value": "",
                  "disabled": true,
                  "description": "Only the last N hours (max 720)."
                },
                {
                  "key": "q",
                  "value": "",
                  "disabled": true,
                  "description": "Free text over username, file name and IP."
                },
                {
                  "key": "limit",
                  "value": "100",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "since_id",
                  "value": "",
                  "disabled": true,
                  "description": ""
                },
                {
                  "key": "before_id",
                  "value": "",
                  "disabled": true,
                  "description": ""
                }
              ]
            }
